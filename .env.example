# Public browser configuration for the Phase 2 Supabase client.
# These values identify the Supabase project; authorization is enforced by
# Supabase Auth + Postgres RLS, not by keeping these browser values secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional public Cloudflare Turnstile site key for Auth challenge readiness.
# Leave empty until the matching hosted Supabase CAPTCHA configuration is enabled.
# The Turnstile secret key must never be placed in a VITE_* variable or frontend code.
VITE_TURNSTILE_SITE_KEY=
